[Unit]
Description=Agent00X GitHub App Broker preflight
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=alex
Group=alex
WorkingDirectory=/home/alex/agent00x-broker/app
EnvironmentFile=/home/alex/agent00x-broker/.env.github-app
ExecStart=/usr/bin/python3 scripts/github_app_preflight.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
