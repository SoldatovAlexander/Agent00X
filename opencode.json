{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "executor",
  "share": "disabled",
  "subagent_depth": 0,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rg *": "allow",
      "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -q": "allow",
      "python3 -m unittest discover -s tests -q": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "rm *": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "__pycache__/**",
      ".pytest_cache/**"
    ]
  }
}
