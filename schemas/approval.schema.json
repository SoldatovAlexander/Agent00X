{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/approval.schema.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "approver_id", "process_id", "operation", "repository_id", "staged_change_digest", "policy_version", "approved_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "approval_id": {"type": "string", "pattern": "^approval-[a-z0-9-]+$"},
    "approver_id": {"type": "string", "minLength": 1},
    "process_id": {"type": "string", "pattern": "^process-[a-z0-9-]+$"},
    "operation": {"const": "publish_pull_request"},
    "repository_id": {"type": "string", "pattern": "^github-installation/[0-9]+/repository/[0-9]+$"},
    "staged_change_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
