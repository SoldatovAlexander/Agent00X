{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/capability-grant.schema.json",
  "title": "CapabilityGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "issuer", "subject", "original_principal", "process_id", "actions", "resources", "audience", "delegable_actions", "max_delegation_depth", "issued_at", "expires_at", "policy_version", "nonce", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "grant_id": {"type": "string", "pattern": "^grant-[a-z0-9-]+$"},
    "issuer": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "original_principal": {"type": "string", "minLength": 1},
    "process_id": {"type": "string", "pattern": "^process-[a-z0-9-]+$"},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "delegable_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "max_delegation_depth": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "revoked"]}
  }
}
