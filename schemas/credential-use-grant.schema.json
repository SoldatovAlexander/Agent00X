{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/credential-use-grant.schema.json",
  "title": "CredentialUseGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credential_grant_id", "credential_class", "installation_id", "repository_id", "permissions", "actuator_id", "operation", "request_digest", "single_use", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "credential_grant_id": {"type": "string", "pattern": "^credential-grant-[a-z0-9-]+$"},
    "credential_class": {"const": "github-app-installation"},
    "installation_id": {"type": "integer", "minimum": 1},
    "repository_id": {"type": "string", "pattern": "^github-installation/[0-9]+/repository/[0-9]+$"},
    "permissions": {"type": "array", "minItems": 1, "items": {"enum": ["contents:write", "pull_requests:write"]}},
    "actuator_id": {"type": "string", "pattern": "^actuator-[a-z0-9-]+$"},
    "operation": {"const": "publish_pull_request"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "single_use": {"const": true},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
