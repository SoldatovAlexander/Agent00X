{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/delegation-receipt.schema.json",
  "title": "DelegationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delegation_id", "parent_grant_id", "issuer", "child_subject", "process_id", "actions", "resources", "audience", "effort_budget", "remaining_delegation_depth", "issued_at", "expires_at", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "delegation_id": {"type": "string", "pattern": "^delegation-[a-z0-9-]+$"},
    "parent_grant_id": {"type": "string", "pattern": "^grant-[a-z0-9-]+$"},
    "issuer": {"type": "string", "minLength": 1},
    "child_subject": {"type": "string", "minLength": 1},
    "process_id": {"type": "string", "pattern": "^process-[a-z0-9-]+$"},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effort_budget": {"type": "integer", "minimum": 1},
    "remaining_delegation_depth": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "revoked"]}
  }
}
