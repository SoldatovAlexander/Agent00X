{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/learning-correction.schema.json",
  "title": "LearningCorrection",
  "description": "Minimal R0 contract for a versioned learning correction from document 28. Links checkpoint, events and review; never a capability, credential, token or policy mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correction_id", "version", "checkpoint_id", "target_event_id", "author_id", "created_at", "error_description", "explanation", "expected_action", "applicability", "evidence_refs", "review_status"],
  "properties": {
    "schema_version": {"const": 1},
    "correction_id": {"type": "string", "pattern": "^correction-[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint-[a-z0-9-]+$"},
    "target_event_id": {"type": "string", "pattern": "^event-[a-z0-9-]+$"},
    "author_id": {"type": "string", "pattern": "^(agent|service|human)-[a-z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "error_description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "explanation": {"type": "string", "minLength": 1, "maxLength": 2000},
    "expected_action": {"type": "string", "minLength": 1, "maxLength": 2000},
    "applicability": {"type": "string", "minLength": 1, "maxLength": 2000},
    "counterexamples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "proposed_configuration_change": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://[A-Za-z0-9_./-]+$", "minLength": 12, "maxLength": 256}},
    "evaluation_case_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://[A-Za-z0-9_./-]+$", "minLength": 12, "maxLength": 256}},
    "baseline_build_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_build_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "review_status": {"enum": ["proposed", "evaluated", "approved", "rejected"]},
    "approval_ref": {"type": "string", "pattern": "^artifact://[A-Za-z0-9_./-]+$", "minLength": 12, "maxLength": 256},
    "supersedes": {"type": "string", "pattern": "^correction-[a-z0-9-]+$"}
  }
}
