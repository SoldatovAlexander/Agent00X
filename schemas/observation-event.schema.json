{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/observation-event.schema.json",
  "title": "ObservationEvent",
  "description": "Minimal R0 contract for a structured observer event from document 28. Values must not contain secrets or raw prompts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "process_id", "run_id", "branch_id", "task_id", "agent_id", "sequence", "occurred_at", "recorded_at", "classification", "redaction_status"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^event-[a-z0-9-]+$"},
    "event_type": {"enum": ["decision_proposed", "decision_applied", "tool_requested", "tool_completed", "tool_failed", "tool_denied", "outcome_unknown", "agent_started", "agent_finished", "correction_proposed", "branch_created"]},
    "process_id": {"type": "string", "pattern": "^process-[a-z0-9-]+$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "branch_id": {"type": "string", "pattern": "^branch-[a-z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"},
    "agent_id": {"type": "string", "pattern": "^(agent|service)-[a-z0-9-]+$"},
    "parent_agent_id": {"type": "string", "pattern": "^(agent|service)-[a-z0-9-]+$"},
    "sequence": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "causal_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^event-[a-z0-9-]+$"}},
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint-[a-z0-9-]+$"},
    "invocation_id": {"type": "string", "pattern": "^invocation-[a-z0-9-]+$"},
    "state_version": {"type": "integer", "minimum": 1},
    "agent_build_id": {"type": "string", "minLength": 1},
    "procedure_version": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://"}},
    "output_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://"}},
    "decision_or_tool": {"type": "string", "minLength": 1},
    "safe_parameters": {"type": "object"},
    "rationale": {"type": "string", "minLength": 1},
    "expected_result": {"type": "string", "minLength": 1},
    "authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://"}},
    "status": {"enum": ["pending", "ok", "failed", "denied", "unknown"]},
    "error_code": {"type": "string", "minLength": 1},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "redaction_status": {"enum": ["complete", "redacted"]}
  }
}
