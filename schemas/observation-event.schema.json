{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/observation-event.schema.json",
  "title": "ObservationEvent",
  "description": "Minimal R0 contract for a structured observer event from document 28. safe_parameters is a strict allowlist of typed redacted metadata; raw payload, secret-like keys and prompt text are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "process_id", "run_id", "branch_id", "task_id", "agent_id", "sequence", "occurred_at", "recorded_at", "classification", "redaction_status"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^event-[a-z0-9-]+$"},
    "event_type": {"enum": ["decision_proposed", "decision_applied", "tool_requested", "tool_completed", "tool_failed", "tool_denied", "outcome_unknown", "agent_started", "agent_finished", "run_finished", "correction_proposed", "branch_created"]},
    "process_id": {"type": "string", "pattern": "^process-[a-z0-9-]+$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "branch_id": {"type": "string", "pattern": "^branch-[a-z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"},
    "agent_id": {"type": "string", "pattern": "^(agent|service)-[a-z0-9-]+$"},
    "parent_agent_id": {"type": "string", "pattern": "^(agent|service)-[a-z0-9-]+$"},
    "sequence": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "causal_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^event-[a-z0-9-]+$"}},
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint-[a-z0-9-]+$"},
    "invocation_id": {"type": "string", "pattern": "^invocation-[a-z0-9-]+$"},
    "state_version": {"type": "integer", "minimum": 1},
    "agent_build_id": {"type": "string", "minLength": 1},
    "procedure_version": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://"}},
    "output_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://"}},
    "decision_or_tool": {"type": "string", "minLength": 1},
    "safe_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$", "minLength": 1, "maxLength": 256},
        "max_bytes": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "artifact_ref": {"type": "string", "pattern": "^artifact://[A-Za-z0-9_./-]+$", "minLength": 12, "maxLength": 256},
        "worker_outcome": {"enum": ["clarification_required", "blocked", "denied"]},
        "sandbox_return_code": {"type": "integer", "minimum": -255, "maximum": 255},
        "sandbox_failure_code": {
          "enum": [
            "readiness-exit", "readiness-timeout", "overflow-status", "overflow-no-write",
            "valid-status", "valid-body", "valid-row",
            "malformed-status-level-bool", "malformed-no-write-level-bool",
            "malformed-status-level-fractional", "malformed-no-write-level-fractional",
            "malformed-status-level-numeric-string", "malformed-no-write-level-numeric-string",
            "sqlite-range-status-level-above", "sqlite-range-no-write-level-above",
            "sqlite-range-status-level-below", "sqlite-range-no-write-level-below",
            "malformed-status-correct-bool", "malformed-no-write-correct-bool",
            "malformed-status-correct-fractional", "malformed-no-write-correct-fractional",
            "malformed-status-correct-numeric-string", "malformed-no-write-correct-numeric-string",
            "sqlite-range-status-correct-above", "sqlite-range-no-write-correct-above",
            "sqlite-range-status-correct-below", "sqlite-range-no-write-correct-below",
            "malformed-status-wrong-bool", "malformed-no-write-wrong-bool",
            "malformed-status-wrong-fractional", "malformed-no-write-wrong-fractional",
            "malformed-status-wrong-numeric-string", "malformed-no-write-wrong-numeric-string",
            "sqlite-range-status-wrong-above", "sqlite-range-no-write-wrong-above",
            "sqlite-range-status-wrong-below", "sqlite-range-no-write-wrong-below",
            "malformed-status-total-bool", "malformed-no-write-total-bool",
            "malformed-status-total-fractional", "malformed-no-write-total-fractional",
            "malformed-status-total-numeric-string", "malformed-no-write-total-numeric-string",
            "sqlite-range-status-total-above", "sqlite-range-no-write-total-above",
            "sqlite-range-status-total-below", "sqlite-range-no-write-total-below",
            "malformed-status-time_ms-bool", "malformed-no-write-time_ms-bool",
            "malformed-status-time_ms-fractional", "malformed-no-write-time_ms-fractional",
            "malformed-status-time_ms-numeric-string", "malformed-no-write-time_ms-numeric-string",
            "sqlite-range-status-time_ms-above", "sqlite-range-no-write-time_ms-above",
            "sqlite-range-status-time_ms-below", "sqlite-range-no-write-time_ms-below"
          ]
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "expected_result": {"type": "string", "minLength": 1},
    "authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^artifact://"}},
    "status": {"enum": ["pending", "ok", "failed", "denied", "unknown"]},
    "error_code": {"type": "string", "minLength": 1},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "redaction_status": {"enum": ["complete", "redacted"]}
  }
}
