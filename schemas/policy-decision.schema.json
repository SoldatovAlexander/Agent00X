{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "effect", "reason_codes", "principal_id", "operation", "repository_id", "staged_change_digest", "policy_version", "evaluated_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^decision-[a-z0-9-]+$"},
    "effect": {"enum": ["allow", "deny"]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "principal_id": {"type": "string", "minLength": 1},
    "operation": {"const": "publish_pull_request"},
    "repository_id": {"type": "string", "pattern": "^github-installation/[0-9]+/repository/[0-9]+$"},
    "staged_change_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
