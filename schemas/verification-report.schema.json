{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process.local/schemas/verification-report.schema.json",
  "title": "VerificationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "process_id", "evidence_digest", "verifier_id", "verifier_build_id", "checks", "verdict", "blockers", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "verification_id": {"type": "string", "pattern": "^verification-[a-z0-9-]+$"},
    "process_id": {"type": "string", "pattern": "^process-[a-z0-9-]+$"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_build_id": {"type": "string", "pattern": "^build-[a-z0-9-]+$"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "status", "evidence_ref"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "inconclusive"]},
          "evidence_ref": {"type": "string", "pattern": "^artifact://"}
        }
      }
    },
    "verdict": {"enum": ["pass", "conditional", "fail"]},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
